# Public Mapbox access token (starts with "pk."). Required to render the map.
# Create one at https://account.mapbox.com/access-tokens/ with at least the
# styles:tiles, styles:read and fonts:read scopes.
VITE_MAPBOX_ACCESS_TOKEN=

# Optional: override the Mapbox style. Defaults to the story's custom style.
# VITE_MAPBOX_STYLE=mapbox://styles/mathhulk/cl0ovzd7j000u14mlcv35f827
